LEVELS_DIR=X:/SteamLibrary/steamapps/common/Beat Saber/Beat Saber_Data/CustomLevels
SABER_PORT=8100
YT_MAX_MINUTES=20
MAX_UPLOAD_MB=200
# Beat Saber Playlists folder on the host; enables the BeatSaver .bplist export when set.
# PLAYLISTS_DIR_HOST=X:/SteamLibrary/steamapps/common/Beat Saber/Playlists
# Beat Saber folder on the host; lets the Settings tab check for and install PlaylistManager (writes to Plugins and Libs).
# GAME_DIR_HOST=X:/SteamLibrary/steamapps/common/Beat Saber
# Extra Host names the service accepts besides 127.0.0.1, localhost and [::1] (comma list).
# SABER_ALLOWED_HOSTS=saber.lan
# Linux hosts: uid/gid the container runs as. LEVELS_DIR must be writable by this uid.
# PUID=1000
# PGID=1000
# Comma list of single proxy addresses whose X-Forwarded-Host/Proto are trusted (empty = off).
# Also add the proxy upstream host name to SABER_ALLOWED_HOSTS.
# SABER_TRUSTED_PROXY_IPS=172.18.0.2
# VR mode: where the container finds the host helper (`task st:vr-agent`). Default shown.
# VR_AGENT_URL=http://host.docker.internal:8101/status
# LAN access for a standalone headset browser. There is no login: anyone on the network can fix, crop, download and delete maps. Also list the host names in SABER_ALLOWED_HOSTS.
# SABER_BIND=0.0.0.0
# HTTPS with a self-signed certificate (1 or true). Generated once into the data volume (/data/tls); open https://127.0.0.1:8100 and accept the browser warning.
# SABER_TLS=1
# Extra host names or IPs for the certificate (comma list); also list them in SABER_ALLOWED_HOSTS.
# SABER_TLS_HOSTS=saber.lan,192.168.1.20
# Your own certificate and key as paths inside the container (mount them yourself); never overwritten.
# SABER_TLS_CERT=/data/tls/cert.pem
# SABER_TLS_KEY=/data/tls/key.pem
# CLI client: API URL, and SABER_TLS_VERIFY=0 to skip verification of the self-signed certificate.
# SABER_API=https://127.0.0.1:8100
# SABER_TLS_VERIFY=0
# Analyser requests in flight at once, across all job workers (default 1).
# ANALYSER_CONCURRENCY=1
